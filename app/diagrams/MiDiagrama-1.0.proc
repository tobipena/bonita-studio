              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_hXAhOM28EfGunNLVBztyKg" key="body">
                <expression xmi:type="expression:Expression" xmi:id="_hXAhOc28EfGunNLVBztyKg" name="body()" content="import groovy.json.JsonOutput&#xD;&#xA;import groovy.json.JsonSlurper&#xD;&#xA;&#xD;&#xA;if (emergenciaId == null || emergenciaId &lt;= 0L) {&#xD;&#xA;    throw new IllegalStateException(&quot;Falta emergenciaId válido para registrar compromiso&quot;)&#xD;&#xA;}&#xD;&#xA;if (!tokenSistemaNacional?.trim() || !urlSistemaNacional?.trim()) {&#xD;&#xA;    throw new IllegalStateException(&quot;Falta token o URL del Sistema Nacional&quot;)&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;String base = urlSistemaNacional.trim().replaceAll('/+$', '')&#xD;&#xA;String ref = emergenciaId.toString()&#xD;&#xA;String token = tokenSistemaNacional.trim()&#xD;&#xA;&#xD;&#xA;def recibidas = new JsonSlurper().parseText(ofertasRecibidasJson ?: '[]')&#xD;&#xA;if (!(recibidas instanceof List)) {&#xD;&#xA;    throw new IllegalStateException(&quot;ofertasRecibidasJson debe ser una lista&quot;)&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;def activas = recibidas.findAll { it.estado in ['Registrada', 'Rectificada', 'Validada'] }&#xD;&#xA;if (activas.isEmpty()) {&#xD;&#xA;    throw new IllegalStateException(&quot;No hay ofertas activas para bloquear&quot;)&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// ong -> (tipoRecurso -> cantidad)&#xD;&#xA;Map&lt;String, Map&lt;String, Integer>> porOng = [:].withDefault { [:].withDefault { 0 } }&#xD;&#xA;&#xD;&#xA;activas.each { oferta ->&#xD;&#xA;    if (!oferta.ongLider?.trim()) {&#xD;&#xA;        throw new IllegalStateException(&quot;Oferta ${oferta.id} sin ongLider&quot;)&#xD;&#xA;    }&#xD;&#xA;    if (!(oferta.cantidadOfrecida instanceof Number) || oferta.cantidadOfrecida &lt;= 0) {&#xD;&#xA;        throw new IllegalStateException(&quot;Oferta ${oferta.id} con cantidad inválida&quot;)&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    String recurso = oferta.tipoRecursoNacional ?: oferta.loteNombre&#xD;&#xA;    if (!oferta.tipoRecursoNacional &amp;&amp; oferta.unidad) {&#xD;&#xA;        String sufijo = ' (' + oferta.unidad.toString().trim() + ')'&#xD;&#xA;        if (recurso.length() > sufijo.length()&#xD;&#xA;                &amp;&amp; recurso.regionMatches(true, recurso.length() - sufijo.length(), sufijo, 0, sufijo.length())) {&#xD;&#xA;            recurso = recurso.substring(0, recurso.length() - sufijo.length()).trim()&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    if (!recurso?.trim()) {&#xD;&#xA;        throw new IllegalStateException(&quot;Oferta ${oferta.id} sin tipo de recurso&quot;)&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    String ong = oferta.ongLider.trim()&#xD;&#xA;    int cant = oferta.cantidadOfrecida as int&#xD;&#xA;    porOng[ong][recurso] = porOng[ong][recurso] + cant&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;def resultados = []&#xD;&#xA;&#xD;&#xA;porOng.each { ong, recursos ->&#xD;&#xA;    def items = recursos.collect { tipo, cant -> [tipoRecurso: tipo, cantidad: cant] }&#xD;&#xA;    def payload = [proyectoRef: ref, ong: ong, items: items]&#xD;&#xA;&#xD;&#xA;    def conexion = (java.net.HttpURLConnection) new URL(base + '/api/recursos/bloqueos').openConnection()&#xD;&#xA;    conexion.requestMethod = 'POST'&#xD;&#xA;    conexion.doOutput = true&#xD;&#xA;    conexion.connectTimeout = 10000&#xD;&#xA;    conexion.readTimeout = 90000&#xD;&#xA;    conexion.instanceFollowRedirects = false&#xD;&#xA;    conexion.setRequestProperty('Content-Type', 'application/json; charset=UTF-8')&#xD;&#xA;    conexion.setRequestProperty('Authorization', 'Bearer ' + token)&#xD;&#xA;&#xD;&#xA;    try {&#xD;&#xA;        conexion.outputStream.withCloseable {&#xD;&#xA;            it.write(JsonOutput.toJson(payload).getBytes('UTF-8'))&#xD;&#xA;        }&#xD;&#xA;        int code = conexion.responseCode&#xD;&#xA;        String body = (code >= 200 &amp;&amp; code &lt; 300)&#xD;&#xA;                ? conexion.inputStream.withCloseable { it.getText('UTF-8') }&#xD;&#xA;                : conexion.errorStream?.withCloseable { it.getText('UTF-8') } ?: ''&#xD;&#xA;&#xD;&#xA;        if (code != 200 &amp;&amp; code != 201) {&#xD;&#xA;            throw new IllegalStateException(&#xD;&#xA;                    &quot;Bloqueo HTTP ${code} para ONG ${ong}. Body: ${body}. Payload: ${JsonOutput.toJson(payload)}&quot;)&#xD;&#xA;        }&#xD;&#xA;        resultados &lt;&lt; [ong: ong, http: code, respuesta: body]&#xD;&#xA;    } finally {&#xD;&#xA;        conexion.disconnect()&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;return JsonOutput.toJson(resultados)" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnTypeFixed="true">
