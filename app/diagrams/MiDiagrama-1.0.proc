            <rightOperand xmi:type="expression:Expression" xmi:id="_sUaGgsBNEfGWxIOyyopWBw" name="consultarCoberturaBackend()" content="if (emergenciaId == null || emergenciaId &lt;= 0L) {&#xD;&#xA;&#x9;throw new IllegalStateException(&quot;Falta emergenciaId para consultar cobertura&quot;)&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Studio ejecuta Bonita en Windows; Docker publica el backend en este puerto.&#xD;&#xA;def baseUrl = &quot;http://localhost:8080&quot;&#xD;&#xA;def url = new java.net.URL(baseUrl + &quot;/api/emergencias/&quot; + emergenciaId + &quot;/cobertura&quot;)&#xD;&#xA;def conexion = (java.net.HttpURLConnection) url.openConnection()&#xD;&#xA;conexion.setRequestMethod(&quot;GET&quot;)&#xD;&#xA;conexion.setConnectTimeout(5000)&#xD;&#xA;conexion.setReadTimeout(10000)&#xD;&#xA;conexion.setRequestProperty(&quot;Accept&quot;, &quot;application/json&quot;)&#xD;&#xA;&#xD;&#xA;try {&#xD;&#xA;&#x9;int codigo = conexion.getResponseCode()&#xD;&#xA;&#x9;if (codigo != 200) {&#xD;&#xA;&#x9;&#x9;throw new IllegalStateException(&quot;Consulta de cobertura respondió HTTP &quot; + codigo)&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;String json = conexion.getInputStream().withCloseable { entrada ->&#xD;&#xA;&#x9;&#x9;entrada.getText(&quot;UTF-8&quot;)&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;def respuesta = new groovy.json.JsonSlurper().parseText(json)&#xD;&#xA;&#x9;if (respuesta.emergenciaId == null ||&#xD;&#xA;&#x9;&#x9;&#x9;respuesta.emergenciaId.toString() != emergenciaId.toString()) {&#xD;&#xA;&#x9;&#x9;throw new IllegalStateException(&quot;La cobertura corresponde a otra emergencia&quot;)&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;if (!(respuesta.coberturaCompleta instanceof Boolean)) {&#xD;&#xA;&#x9;&#x9;throw new IllegalStateException(&quot;La respuesta no contiene una cobertura Boolean&quot;)&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;return respuesta.coberturaCompleta&#xD;&#xA;} finally {&#xD;&#xA;&#x9;conexion.disconnect()&#xD;&#xA;}" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.Boolean">
