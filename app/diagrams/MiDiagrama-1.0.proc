          <connectors xmi:type="process:Connector" xmi:id="_sSW0AM1yEfGlEewDVUxSJw" name="validarTodasLasOfertas" definitionId="scripting-groovy-script" event="ON_ENTER" definitionVersion="1.0.1">
            <configuration xmi:type="connectorconfiguration:ConnectorConfiguration" xmi:id="_sSW0Ac1yEfGlEewDVUxSJw" definitionId="scripting-groovy-script" version="1.0.1" modelVersion="9">
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_sSW0As1yEfGlEewDVUxSJw" key="script">
                <expression xmi:type="expression:Expression" xmi:id="_sSW0A81yEfGlEewDVUxSJw" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnTypeFixed="true"/>
              </parameters>
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_sSW0BM1yEfGlEewDVUxSJw" key="variables">
                <expression xmi:type="expression:Expression" xmi:id="_sSW0Bc1yEfGlEewDVUxSJw" returnType="java.util.List" returnTypeFixed="true"/>
              </parameters>
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_sSW0Bs1yEfGlEewDVUxSJw" key="fakeScriptExpression">
                <expression xmi:type="expression:Expression" xmi:id="_sSW0B81yEfGlEewDVUxSJw" name="newScript()" content="import groovy.json.JsonOutput&#xD;&#xA;import groovy.json.JsonSlurper&#xD;&#xA;&#xD;&#xA;def recibidas = new JsonSlurper().parseText(ofertasRecibidasJson)&#xD;&#xA;if (!(recibidas instanceof List)) throw new IllegalStateException(&quot;Se esperaba una lista de ofertas&quot;)&#xD;&#xA;def activas = recibidas.findAll { it.estado in [&quot;Registrada&quot;, &quot;Rectificada&quot;, &quot;Validada&quot;] }&#xD;&#xA;if (activas.isEmpty()) return &quot;[]&quot;&#xD;&#xA;if (!tokenSistemaNacional?.trim() || !urlSistemaNacional?.trim()) throw new IllegalStateException(&quot;Falta token o URL nacional&quot;)&#xD;&#xA;String base = urlSistemaNacional.trim().replaceAll('/+$', '')&#xD;&#xA;def resultados = []&#xD;&#xA;def ids = new HashSet()&#xD;&#xA;for (oferta in activas) {&#xD;&#xA;    if (!oferta.id || !ids.add(oferta.id.toString()) || !oferta.ongLider || !oferta.nivelGravedad&#xD;&#xA;            || !oferta.loteNombre || !(oferta.cantidadOfrecida instanceof Number) || oferta.cantidadOfrecida &lt;= 0) {&#xD;&#xA;        throw new IllegalStateException(&quot;Oferta incompleta o duplicada: &quot; + oferta.id)&#xD;&#xA;    }&#xD;&#xA;    String recurso = oferta.tipoRecursoNacional ?: oferta.loteNombre&#xD;&#xA;    if (!oferta.tipoRecursoNacional &amp;&amp; oferta.unidad) {&#xD;&#xA;        String sufijo = &quot; (&quot; + oferta.unidad.toString().trim() + &quot;)&quot;&#xD;&#xA;        if (recurso.length() > sufijo.length() &amp;&amp; recurso.regionMatches(true, recurso.length() - sufijo.length(), sufijo, 0, sufijo.length())) {&#xD;&#xA;            recurso = recurso.substring(0, recurso.length() - sufijo.length()).trim()&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    def conexion = (HttpURLConnection) new URL(base + &quot;/api/validacion/competencias&quot;).openConnection()&#xD;&#xA;    conexion.requestMethod = &quot;POST&quot;; conexion.doOutput = true&#xD;&#xA;    conexion.connectTimeout = 10000; conexion.readTimeout = 90000; conexion.instanceFollowRedirects = false&#xD;&#xA;    conexion.setRequestProperty(&quot;Content-Type&quot;, &quot;application/json; charset=UTF-8&quot;)&#xD;&#xA;    conexion.setRequestProperty(&quot;Authorization&quot;, &quot;Bearer &quot; + tokenSistemaNacional.trim())&#xD;&#xA;    try {&#xD;&#xA;        def payload = [ong: oferta.ongLider, gravedad: oferta.nivelGravedad, items: [[tipoRecurso: recurso, cantidad: oferta.cantidadOfrecida]]]&#xD;&#xA;        conexion.outputStream.withCloseable { it.write(JsonOutput.toJson(payload).getBytes(&quot;UTF-8&quot;)) }&#xD;&#xA;        if (conexion.responseCode != 200) throw new IllegalStateException(&quot;API nacional respondió HTTP &quot; + conexion.responseCode + &quot; para oferta &quot; + oferta.id)&#xD;&#xA;        def perfil = new JsonSlurper().parseText(conexion.inputStream.withCloseable { it.getText(&quot;UTF-8&quot;) })&#xD;&#xA;        if (!(perfil.capacidades instanceof List) || perfil.capacidades.isEmpty() || !perfil.resultado) throw new IllegalStateException(&quot;Perfil nacional incompleto&quot;)&#xD;&#xA;        resultados.add([ofertaId: oferta.id.toString().toLong(), perfil: perfil])&#xD;&#xA;    } finally { conexion.disconnect() }&#xD;&#xA;}&#xD;&#xA;return JsonOutput.toJson(resultados)&#xD;&#xA;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.Object" returnTypeFixed="true">
